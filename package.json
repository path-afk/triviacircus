{
  "name": "trivia-circus",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:importer": "node --test importer/test/importer.test.js",
    "test:all": "node --test --test-concurrency=1 tests/*.test.js && node --test importer/test/importer.test.js",
    "import": "node importer/src/cli.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "socket.io-client": "^4.7.2"
  }
}
